# Generate a key with: openssl rand -hex 32
API_KEY=REPLACE_WITH_A_RANDOM_64_CHARACTER_HEX_KEY

# Must be reachable from the bridge container
SPLIIT_BASE_URL=http://spliit:3000

# Keep false until expense creation is intentionally enabled
ALLOW_CREATE=false

# Existing Docker network shared with Spliit
SPLIIT_DOCKER_NETWORK=spliit-net

RATE_LIMIT_PER_MINUTE=120
LOG_LEVEL=INFO
